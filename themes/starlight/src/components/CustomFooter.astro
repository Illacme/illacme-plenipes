---
import Default from '@astrojs/starlight/components/Footer.astro';
import type { Props } from '@astrojs/starlight/props';
import { readFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';

// Read graph.json from public/ at SSR/build time
let graphData: any = { backlinks: {} };
try {
  const raw = readFileSync(resolve(process.cwd(), 'public/graph.json'), 'utf-8');
  graphData = JSON.parse(raw);
} catch { /* graph.json not yet generated — silently skip */ }

// Read theme.options.json at SSR/build time
let themeOptions: any = {};
try {
  const optPath = resolve(process.cwd(), 'theme.options.json');
  if (existsSync(optPath)) {
    themeOptions = JSON.parse(readFileSync(optPath, 'utf-8'));
  }
} catch { /* options not found — fallback */ }

const currentPath = Astro.url.pathname;
const allBacklinks = graphData.backlinks || {};

// Normalize to prevent trailing slash mismatch
const normalizePath = (p: string) => (() => {
	const replaced = p.replace(/\/$/, '');
	return replaced === '' ? '/' : replaced;
})();
const normalizedCurrent = normalizePath(currentPath);

const backlinksForPage = Object.keys(allBacklinks).reduce((acc, key) => {
	const kClean = normalizePath(key);
	if (kClean === normalizedCurrent || (normalizedCurrent !== '/' && (kClean.endsWith(normalizedCurrent) || normalizedCurrent.endsWith(kClean)))) {
		return acc.concat(allBacklinks[key as keyof typeof allBacklinks]);
	}
	return acc;
}, [] as { url: string; title: string }[]);

const isEnglish = currentPath.startsWith('/en/');
const isJapanese = currentPath.startsWith('/ja/');
const uiTitle = isEnglish ? "🔗 Linked Mentions" : (isJapanese ? "🔗 双方向リンクと参照" : "🔗 双向链接与引用回响");
const uiSubtitle = isEnglish ? "Documents referencing this page" : (isJapanese ? "このページを参照している文書" : "提及本篇的手稿");

const resolveStarlightUrl = (rawUrl: string) => {
	if (!rawUrl) return '/';
	let u = String(rawUrl).trim();
	u = u.replace(/\/engineering\/engineering\//g, '/engineering/');
	if (u.startsWith('/docs/')) {
		u = u.replace(/^\/docs\//, '/');
	}
	return u || '/';
};

// Compliance & Identity options
const siteName = themeOptions.site_name || 'Illacme Plenipes';
const currentYear = new Date().getFullYear();
const copyright = themeOptions.footer_copyright || `© ${currentYear} ${siteName}. All Rights Reserved.`;
const license = themeOptions.license || 'CC BY-NC-SA 4.0';
const icpLicense = themeOptions.icp_license;
const policeLicense = themeOptions.police_license;
---

{backlinksForPage.length > 0 && (
<section class="linked-mentions-container">
	<div class="mentions-header">
		<div class="title-group">
			<span class="main-title">{uiTitle}</span>
			<span class="count-badge">{backlinksForPage.length}</span>
		</div>
		<span class="sub-title">{uiSubtitle}</span>
	</div>
	<div class="mentions-grid">
		{backlinksForPage.map((link) => {
			const targetUrl = resolveStarlightUrl(link.url);
			return (
				<a href={targetUrl} class="mention-card">
					<span class="link-title">📄 {link.title || link.url}</span>
					<span class="arrow-icon">↗</span>
				</a>
			);
		})}
	</div>
</section>
)}

<!-- 先渲染 Starlight 原生的翻页器和编辑链接 -->
<Default {...Astro.props} />

<!-- 然后追加极具质感的出版合规与全域版权栏 -->
<footer class="custom-global-footer">
	<div class="compliance-shield-bar">
		{copyright && <span class="compliance-item copyright-text">{copyright}</span>}
		
		{license && (
			<span class="compliance-item license-item">
				<span class="badge-icon">⚖️</span>
				<a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">
					{license}
				</a>
			</span>
		)}

		{icpLicense && (
			<span class="compliance-item icp-item">
				<span class="badge-icon">📜</span>
				<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
					{icpLicense}
				</a>
			</span>
		)}

		{policeLicense && (
			<span class="compliance-item police-item">
				<svg class="police-badge-svg" viewBox="0 0 32 32" width="13" height="13" fill="currentColor">
					<path d="M16 2 L28 7 L28 15 C28 22.5 22.8 28.6 16 30 C9.2 28.6 4 22.5 4 15 L4 7 Z" fill="none" stroke="currentColor" stroke-width="2"/>
					<path d="M16 7 L23 10.5 L23 15 C23 19.5 19.8 24.2 16 25.5 C12.2 24.2 9 19.5 9 15 L9 10.5 Z" fill="currentColor" opacity="0.85"/>
					<polygon points="16,11 17.5,14 20.5,14.5 18.2,16.8 18.8,20 16,18.3 13.2,20 13.8,16.8 11.5,14.5 14.5,14" fill="#fff"/>
				</svg>
				<a href="http://www.beian.gov.cn/" target="_blank" rel="noopener noreferrer">
					{policeLicense}
				</a>
			</span>
		)}
	</div>

	<p class="powered-by">
		Powered by <a href="https://github.com/Illacme/illacme-plenipes" target="_blank" rel="noopener noreferrer">Illacme-plenipes</a> · Sovereign Publishing Engine
	</p>
</footer>

<script is:inline>
	if (typeof window !== 'undefined') {
		import('/wiki-preview-core.js').then(m => m.initWikiPreview && m.initWikiPreview()).catch(() => {});
		import('/article-telemetry-core.js').then(m => m.mountArticleTelemetry && m.mountArticleTelemetry()).catch(() => {});
	}
</script>

<style>
.linked-mentions-container {
	margin: 3.5rem 0 2.5rem 0;
	padding: 1.25rem 1.5rem;
	border-radius: 12px;
	border: 1px solid var(--sl-color-gray-5);
	background: var(--sl-color-gray-6);
	backdrop-filter: blur(8px);
	box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.05);
}
.mentions-header {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	flex-wrap: wrap;
	gap: 0.5rem;
	margin-bottom: 1rem;
	padding-bottom: 0.75rem;
	border-bottom: 1px dashed var(--sl-color-gray-5);
}
.title-group { display: inline-flex; align-items: center; gap: 0.6rem; }
.main-title {
	font-size: 0.95rem;
	font-weight: 700;
	letter-spacing: 0.02em;
	color: var(--sl-color-white, var(--sl-color-text));
}

.count-badge {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	font-size: 0.72rem;
	font-weight: 600;
	padding: 0.1rem 0.5rem;
	border-radius: 9999px;
	background: rgba(99, 102, 241, 0.15);
	color: var(--sl-color-text-accent, var(--sl-color-accent));
	border: 1px solid rgba(99, 102, 241, 0.3);
}

.sub-title {
	font-size: 0.75rem;
	color: var(--sl-color-gray-3);
}

.mentions-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
	gap: 0.85rem;
}

.mention-card {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0.75rem 1rem;
	border-radius: 8px;
	border: 1px solid var(--sl-color-gray-5);
	background: var(--sl-color-black);
	text-decoration: none !important;
	color: var(--sl-color-text) !important;
	font-size: 0.88rem;
	font-weight: 500;
	transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.mention-card:hover {
	border-color: var(--sl-color-accent);
	background: var(--sl-color-gray-6);
	transform: translateY(-2px);
	box-shadow: 0 4px 14px -2px rgba(99, 102, 241, 0.25);
	color: var(--sl-color-text-accent, var(--sl-color-accent)) !important;
}

.link-title {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.arrow-icon {
	font-size: 0.8rem;
	opacity: 0.5;
	transition: transform 0.2s ease, opacity 0.2s ease;
	margin-left: 0.5rem;
	flex-shrink: 0;
}

.mention-card:hover .arrow-icon {
	opacity: 1;
	transform: translate(2px, -2px);
}

.custom-global-footer {
	margin-top: 2.5rem;
	padding-top: 1.5rem;
	border-top: 1px solid var(--sl-color-gray-6);
	text-align: center;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 0.65rem;
}

.compliance-shield-bar {
	display: flex;
	align-items: center;
	justify-content: center;
	flex-wrap: wrap;
	gap: 0.6rem 1.25rem;
	font-size: 0.78rem;
	color: var(--sl-color-gray-3);
}

.compliance-item {
	display: inline-flex;
	align-items: center;
	gap: 0.35rem;
	line-height: 1.5;
}

.compliance-item a {
	color: var(--sl-color-gray-3);
	text-decoration: none;
	transition: color 0.2s ease, text-decoration 0.2s ease;
}

.compliance-item a:hover {
	color: var(--sl-color-text-accent);
	text-decoration: underline;
}

.badge-icon {
	font-size: 0.85em;
}

.police-badge-svg {
	vertical-align: -2px;
	color: var(--sl-color-accent);
}

.powered-by {
	font-size: 0.74rem;
	color: var(--sl-color-gray-4);
	margin: 0;
}

.powered-by a {
	color: var(--sl-color-text-accent);
	text-decoration: none;
	font-weight: 500;
}

.powered-by a:hover {
	text-decoration: underline;
}
</style>
