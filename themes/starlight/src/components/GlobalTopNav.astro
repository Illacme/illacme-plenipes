---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import themeOptions from '../../theme.options.js';

// 🚀 1. 获取当前真实的物理 URL 路径与语言环境
const currentPath = Astro.url.pathname;
const currentLocale = Astro.currentLocale || (currentPath.includes('/en/') || currentPath.endsWith('/en') ? 'en' : 'zh');
const isDefaultLocale = currentLocale === 'zh' || !currentLocale;
const langPrefix = isDefaultLocale ? '' : `/${currentLocale}`;

// 🚀 2. 解析多语言动态导航项
const rawNavLinks = (themeOptions?.nav_links_i18n && themeOptions.nav_links_i18n[currentLocale]) || themeOptions?.nav_links || [];

let dynamicNavLinks = [];
if (rawNavLinks.length > 0) {
  dynamicNavLinks = rawNavLinks.map(item => {
    let url = item.url || '/';
    if (!item.external && !url.startsWith('http')) {
      url = url.replace(/^\/?/, '/');
      if (langPrefix && !url.startsWith(langPrefix)) {
        url = `${langPrefix}${url}`;
      }
    }
    return {
      text: item.text || item.raw_text || 'Channel',
      href: url,
      external: item.external || false
    };
  });
} else {
  dynamicNavLinks = [
    { text: currentLocale === 'en' ? 'Docs' : '📚 文档中心', href: `${langPrefix}/docs/`, external: false },
    { text: currentLocale === 'en' ? 'Blog' : '📰 官方博客', href: `${langPrefix}/blog/`, external: false },
  ];
}
---

<div class="custom-header-container">
  <!-- 绝对保留原生的 Logo 和标题渲染逻辑 -->
  <Default {...Astro.props} />
  
  <nav class="global-nav-links">
    {dynamicNavLinks.map(link => {
      const isActive = !link.external && currentPath.startsWith(link.href);
      return (
        <a 
          href={link.href} 
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          class:list={[
            'nav-item', 
            { 'active': isActive }
          ]}
        >
          {link.text}
        </a>
      );
    })}
  </nav>
</div>

<style>
  /* ---------------------------------------------------------
     全局横向导航的工业级排版
     --------------------------------------------------------- */
  .custom-header-container {
    display: flex;
    align-items: center;
    gap: 2.5rem; /* 控制 Logo 区域与导航链接之间的安全间距 */
  }

  .global-nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2px; /* 视觉微调，使其与左侧文本基线完美对齐 */
  }

  .nav-item {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-item:hover,
  .nav-item:focus {
    color: var(--sl-color-white);
  }

  /* 当前激活页面的高亮反馈 */
  .nav-item.active {
    color: var(--sl-color-accent);
  }

  /* 移动端防退化：强制隐藏这套顶部横向导航，交给右侧汉堡抽屉菜单 */
  @media (max-width: 50rem) {
    .global-nav-links {
      display: none;
    }
  }
</style>