#!/usr/bin/env python3
import os
import sys
import glob
import re
import subprocess

# 注入治理工具路径，使 pre-commit 可导入豁免加载器
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '.plenipes', 'tools'))

def get_staged_files():
    result = subprocess.run(['git', 'diff', '--cached', '--name-only'], capture_output=True, text=True)
    return [f for f in result.stdout.split('\n') if f.strip() and os.path.exists(f)]

def count_lines(filepath):
    with open(filepath, 'r', encoding='utf-8') as f:
        return sum(1 for _ in f)

def check_hardcoded_colors(filepath):
    if filepath.endswith('.tokens.css') or filepath.endswith('.base.css'):
        return []
    
    violations = []
    with open(filepath, 'r', encoding='utf-8') as f:
        lines = f.readlines()
        
    for i, line in enumerate(lines):
        if re.search(r'#fff\b|#ffffff\b|#000\b|#000000\b', line, re.IGNORECASE):
            violations.append(f"Line {i+1}: Hardcoded hex color found")
        if re.search(r'rgba\(\s*(255|0)\s*,\s*(255|0)\s*,\s*(255|0)\s*,', line):
            violations.append(f"Line {i+1}: Hardcoded rgba white/black found")
            
    return violations

def main():
    print("🛡️  Illacme Plenipes Integrity Shield (pre-commit hook) 🛡️")
    staged_files = get_staged_files()
    
    if not staged_files:
        print("✅ No files staged for commit.")
        sys.exit(0)
        
    violations_found = False
    
    print("🔍 Scanning staged files for architectural violations...")
    
    from exemption_loader import load_redline_exemptions
    EXEMPT_FILES = load_redline_exemptions()

    for f in staged_files:
        # Check 0: Block history directory from being committed
        if f.startswith('.plenipes/history/'):
            print(f"❌ VIOLATION (Blocked Path): .plenipes/history/ files are strictly forbidden from being committed: {f}")
            violations_found = True

        # Check 1: 300-line physical limit
        if f.endswith(('.py', '.js')) and not f.startswith(('vendor/', 'node_modules/', 'tests/')):
            lines = count_lines(f)
            if lines > 300 and f not in EXEMPT_FILES:
                print(f"❌ VIOLATION (Line Limit): {f} has {lines} lines (Max: 300)")
                violations_found = True

                
        # Check 2: Hardcoded CSS colors
        if f.endswith('.css') and f.startswith('web/dashboard/css/'):
            color_violations = check_hardcoded_colors(f)
            if color_violations:
                print(f"❌ VIOLATION (Hardcoded Colors): {f}")
                for v in color_violations:
                    print(f"   -> {v}")
                violations_found = True

    # Check 3: Observability & Auto-Healing (演进日志自愈)
    import datetime
    today = datetime.date.today().strftime("%Y-%m-%d")
    log_path = ".plenipes/history/logic_evolution.log"
    
    def check_log_exists():
        if not os.path.exists(log_path):
            return False
        with open(log_path, 'r', encoding='utf-8') as f:
            return today in f.read()
            
    if not check_log_exists():
        print("⚠️  [可观测性缺失] 检测到今日逻辑演进日志尚未登记。正在为您自动补全...")
        try:
            res = subprocess.run([sys.executable, "scripts/log_healer.py"], capture_output=True, text=True)
            if res.returncode == 0:
                print("✅ [自愈成功] 逻辑演进日志自愈修补完成。")
            else:
                print(f"❌ [自愈失败] 自动修补发生错误: {res.stderr or res.stdout}")
                violations_found = True
        except Exception as e:
            print(f"❌ [自愈失败] 无法运行自愈脚本: {e}")
            violations_found = True
            
    if not check_log_exists():
        print("❌ VIOLATION (Observability): 今日演进日志未登记且自愈失败。请核对。")
        violations_found = True

    if violations_found:
        print("\n🚫 COMMIT REJECTED 🚫")
        print("Please fix the above architectural violations before committing.")
        print("Illacme Plenipes demands 100% compliance with SOP-01 & SOP-03.")
        sys.exit(1)
        
    print("✅ All checks passed. System integrity maintained.")
    sys.exit(0)

if __name__ == "__main__":
    main()
